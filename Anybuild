# Explicit Wasmer Anybuild plan for the Vite static site.
# The all-files staging flag prevents pnpm from running before package.json is present.
load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config")
load("//anybuild/tools:staticfile.bzl", "staticfile_serve")

config = nodestatic_config(
    schema = 1,
    sws_version = "2.38.0",
    static_dir = "dist/public",
    node_package_manager = "pnpm",
    node_framework = "vite",
    node_server = "node",
    node_build_command = "pnpm run build",
    node_version = "22",
    node_install_requires_all_files = True,
)

build = nodestatic_build(config)
staticfile_serve(config, build, name = "digitalsolutions-cv")
